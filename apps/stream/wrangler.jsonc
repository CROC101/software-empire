{
  // stream: a static SPA on Cloudflare Workers (free plan: files under /assets/ never invoke the Worker,
  // so they stay unlimited). Unknown paths fall back to index.html for the client router.
  // Deployed by .github/workflows/deploy.yml; setup: docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crocwork-stream",
  "compatibility_date": "2026-10-01",
  // the launch gate for pages (asks the hub, via service binding HUB) + /api/oembed + /api/search
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "vars": { "APP": "stream" },
  "services": [{ "binding": "HUB", "service": "crocwork-hub" }],
  // /api/search: fresh (uncached) searches per visitor IP per minute, in each Cloudflare location
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "7001", "simple": { "limit": 10, "period": 60 } },
  ],
  // YOUTUBE_API_KEY is a secret (wrangler secret put YOUTUBE_API_KEY); without it search answers 503
}
