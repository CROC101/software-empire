{
  // stream: a static SPA on Cloudflare Workers (free plan: files under /assets/ never invoke the Worker,
  // so they stay unlimited). Unknown paths fall back to index.html for the client router.
  // Deployed by .github/workflows/deploy.yml; setup: docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crocwork-stream",
  "compatibility_date": "2026-10-01",
  // the launch gate for pages (asks the hub, via service binding HUB) + /api/oembed
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "vars": { "APP": "stream" },
  "services": [{ "binding": "HUB", "service": "crocwork-hub" }],
}
