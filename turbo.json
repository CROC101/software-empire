{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["typegen"]
    },
    "typecheck": {
      "dependsOn": ["typegen"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
