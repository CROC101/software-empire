# Public values only — Vite inlines every VITE_* into the bundle. Never put the service_role key here.
# Local: `pnpm db:status` prints URL and publishable key.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://localhost:3003
VITE_HUB_URL=http://localhost:3000
# Production only: parent domain shared with the hub, e.g. .example.com
VITE_COOKIE_DOMAIN=
