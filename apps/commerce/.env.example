# Public values only — they ship to the browser. Never put the service_role key here.
# Local: `pnpm exec supabase status` prints URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_HUB_URL=http://localhost:3000
# Production only: parent domain shared by all apps, e.g. .example.com
NEXT_PUBLIC_COOKIE_DOMAIN=
